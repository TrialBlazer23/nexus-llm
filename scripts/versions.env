# Pinned third-party versions for scripts/setup.sh
# Bump deliberately after smoke-testing Penryn + Termux builds.

# Stock llama.cpp (dense llama-server + rpc-server). Separate from BigMoe's Helldez fork.
LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"
LLAMA_CPP_REF="${LLAMA_CPP_REF:-v0.6.0}"

# BigMoeOnEdge (bmoe-cli + its own third_party/llama.cpp submodule).
BIGMOE_REPO="${BIGMOE_REPO:-https://github.com/Helldez/BigMoeOnEdge.git}"
BIGMOE_REF="${BIGMOE_REF:-v0.28.0}"

# Minimum Rust for Cargo.lock / edition 2024 crates (see AGENT_LEARNINGS).
NEXUS_RUST_MIN="${NEXUS_RUST_MIN:-1.85.0}"
